# Fredo never commits secrets. Copy this file to .env for the team demo.

# Optional local-provider credentials. Jury machines should leave these blank
# and use the public demo profile instead.
DEEPGRAM_API_KEY=

# PSTN transport. A Deepgram key alone cannot place a real telephone call.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Exact consenting destinations only, comma-separated, canonical E.164.
# The MCP is country-neutral; the operator chooses the exact consenting set.
FREDO_ALLOWED_NUMBERS=

# Full-auto orchestration (browse -> call -> reserve -> calendar). When on, the
# static allowlist and manual preview/consent gate are bypassed and the MCP runs
# unattended. E.164 validation and the emergency/premium/short-code blocklist are
# ALWAYS enforced and cannot be disabled. Enable both only for auto workflows.
FREDO_ALLOW_UNLISTED_DESTINATIONS=0
FREDO_AUTOCONFIRM=0

# Generate with: openssl rand -hex 24
FREDO_ENDPOINT_SECRET=

# A public HTTPS callback is needed for a real Twilio media test.
# The MCP itself remains local and stdio-based.
FREDO_PUBLIC_URL=

# Zero-credential jury mode. The operator publishes these values in
# demo/profile.json; they are not Twilio or Deepgram credentials.
FREDO_DEMO_ENDPOINT=
FREDO_DEMO_ACCESS_TOKEN=
# Explicit operator opt-in for a public allowlist-only demo relay.
FREDO_DEMO_PUBLIC=0
FREDO_HOST=127.0.0.1
FREDO_PORT=8080

# Safe default cap. Values above 180 s require FREDO_ALLOW_EXTENDED_CALLS=1 and
# are hard-capped at 3600 s. Longer calls cost more and extend exposure.
FREDO_MAX_DURATION_SECONDS=180
# Opt-in to allow FREDO_MAX_DURATION_SECONDS above 180 s (1=on).
FREDO_ALLOW_EXTENDED_CALLS=0
FREDO_MAX_CONCURRENT_CALLS=1

# Voice Agent defaults. Override only with models enabled on the Deepgram account.
FREDO_LISTEN_MODEL=flux-general-multi
FREDO_LISTEN_LANGUAGE=en
FREDO_EOT_THRESHOLD=0.7
FREDO_EOT_TIMEOUT_MS=7000
# Optional; leave blank unless a Flux profile explicitly needs eager EOT.
FREDO_EAGER_EOT_THRESHOLD=
FREDO_PROTECT_DISCLOSURE=1
FREDO_SILENCE_REPROMPT_SECONDS=12
FREDO_SILENCE_GOODBYE_SECONDS=10
FREDO_LLM_PROVIDER=open_ai
FREDO_LLM_MODEL=gpt-4o-mini
FREDO_VOICE_MODEL=aura-2-thalia-en

# Leave empty to auto-select the demo relay when demo/profile.json is configured.
# Use `real` for a fully local operator runtime or `mock` for tests.
FREDO_TELEPHONY_PROVIDER=

# Live listen-only audio origin (single HTTPS URL). Enables the widget "Listen"
# button and is the only extra origin allowed in the widget CSP. Requires the
# audio relay to be running there. Leave empty to disable live listening.
FREDO_AUDIO_STREAM_ORIGIN=
