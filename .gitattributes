# Normalize line endings for text files committed to the repo.
* text=auto eol=lf

*.py   text diff=python
*.pyi  text diff=python
*.toml text
*.json text
*.md   text diff=markdown
*.yml  text
*.yaml text
*.sh   text eol=lf
Dockerfile text

*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.mp3  binary
*.wav  binary
*.mp4  binary

# Generated lockfile: hide from diffs and language stats
uv.lock -diff linguist-generated=true
